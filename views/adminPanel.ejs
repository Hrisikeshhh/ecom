<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-tint": "#5f5e5e",
                        "secondary": "#7c5730",
                        "on-tertiary": "#ffffff",
                        "on-surface": "#1a1c1b",
                        "tertiary-fixed": "#e6e2d9",
                        "surface-container": "#efeeec",
                        "secondary-container": "#fdcb9b",
                        "tertiary-container": "#1c1c16",
                        "tertiary-fixed-dim": "#cac6be",
                        "inverse-surface": "#2f3130",
                        "background": "#faf9f7",
                        "on-tertiary-container": "#86847c",
                        "on-secondary": "#ffffff",
                        "surface-bright": "#faf9f7",
                        "on-primary-fixed-variant": "#474746",
                        "primary-container": "#1c1b1b",
                        "outline-variant": "#c4c7c7",
                        "surface-container-high": "#e9e8e6",
                        "surface-container-low": "#f4f3f1",
                        "on-error": "#ffffff",
                        "surface-dim": "#dadad8",
                        "primary-fixed": "#e5e2e1",
                        "primary-fixed-dim": "#c8c6c5",
                        "secondary-fixed-dim": "#eebd8e",
                        "on-primary": "#ffffff",
                        "surface-container-highest": "#e3e2e0",
                        "outline": "#747878",
                        "error": "#ba1a1a",
                        "surface": "#faf9f7",
                        "on-primary-container": "#858383",
                        "error-container": "#ffdad6",
                        "surface-variant": "#e3e2e0",
                        "on-surface-variant": "#444748",
                        "inverse-on-surface": "#f1f1ef",
                        "surface-container-lowest": "#ffffff",
                        "on-error-container": "#93000a",
                        "on-tertiary-fixed-variant": "#484740",
                        "inverse-primary": "#c8c6c5",
                        "on-secondary-container": "#79542d",
                        "on-background": "#1a1c1b",
                        "on-secondary-fixed-variant": "#61401b",
                        "tertiary": "#000000",
                        "primary": "#000000",
                        "secondary-fixed": "#ffdcbd",
                        "on-tertiary-fixed": "#1c1c16",
                        "on-primary-fixed": "#1c1b1b",
                        "on-secondary-fixed": "#2c1600"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "fontFamily": {
                        "headline": ["Manrope"],
                        "body": ["Manrope"],
                        "label": ["Manrope"]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            font-family: 'Manrope', sans-serif;
            background-color: #faf9f7;
        }
    </style>
</head>
<body class="bg-surface text-on-surface selection:bg-secondary-container">
    <% if(success.length>0){ %>
    <span>
        <%= success %>
    </span>
 <% } %>
<!-- TopNavBar -->
<header class="fixed top-0 w-full z-50 bg-stone-50/80 dark:bg-stone-950/80 backdrop-blur-xl">
<div class="flex justify-between items-center px-8 py-6 w-full max-w-screen-2xl mx-auto">
<div class="text-2xl font-black tracking-tighter text-black dark:text-white">ARCHIVE ADMIN</div>
<nav class="hidden md:flex items-center space-x-12 font-manrope tracking-tight font-medium">
<a class="text-black dark:text-white font-bold border-b-2 border-stone-800 dark:border-stone-200 pb-1 hover:text-black dark:hover:text-white transition-colors duration-300" href="#">Dashboard</a>
</nav>
<div class="flex items-center space-x-6">
</div>
</div>
</header>
<!-- SideNavBar -->
<aside class="fixed left-0 top-0 h-full w-64 pt-24 bg-stone-50 dark:bg-stone-950 hidden md:block">
</aside>
<!-- Main Content Canvas -->
<main class="md:ml-64 pt-32 px-8 pb-24 max-w-7xl">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
<!-- Product Creation Column -->
<div class="lg:col-span-7 space-y-16">
<header class="space-y-2">
<span class="label-md tracking-[0.2em] text-secondary font-semibold uppercase">Inventory Management</span>
<h1 class="text-5xl font-extrabold tracking-tighter text-black">Product Details</h1>
</header>
<form class="space-y-12" method="post" action="/products/create" enctype="multipart/form-data">
<!-- File Upload Field -->
<div class="group">
<label class="block text-[10px] font-bold uppercase tracking-[0.15em] text-stone-400 mb-4">Product Image
</label>
<div class="relative w-full aspect-[4/3] bg-surface-container-low border border-dashed border-outline-variant/30 flex flex-col items-center justify-center cursor-pointer hover:bg-surface-container transition-colors">
<span class="material-symbols-outlined text-4xl text-stone-300 mb-2" data-icon="cloud_upload">cloud_upload</span>
<p class="text-sm font-medium text-stone-500">Drop files or click to upload curated photography</p>
<input class="absolute inset-0 opacity-0 cursor-pointer" name="image" type="file"/>
</div>
</div>
<div class="grid grid-cols-1 gap-10">
<!-- Text Input: Name -->
<div class="relative">
<label class="block text-[10px] font-bold uppercase tracking-[0.15em] text-stone-400 mb-1">Product Name</label>
<input class="w-full bg-transparent border-t-0 border-x-0 border-b border-outline/30 focus:border-black focus:ring-0 px-0 py-3 text-lg font-medium placeholder:text-stone-300 transition-all" placeholder="e.g. The Sculptural Tote in Ebony" name="name" type="text"/>
</div>
<div class="grid grid-cols-2 gap-8">
<!-- Text Input: Price -->
<div class="relative">
<label class="block text-[10px] font-bold uppercase tracking-[0.15em] text-stone-400 mb-1">Product Price</label>
<div class="flex items-center">
<span class="text-stone-400 mr-2">$</span>
<input class="w-full bg-transparent border-t-0 border-x-0 border-b border-outline/30 focus:border-black focus:ring-0 px-0 py-3 text-lg font-medium placeholder:text-stone-300 transition-all" placeholder="0.00" type="text" name="price"/>
</div>
</div>
<!-- Text Input: Discount -->
<div class="relative">
<label class="block text-[10px] font-bold uppercase tracking-[0.15em] text-stone-400 mb-1">Discounted Price</label>
<div class="flex items-center">
<span class="text-stone-400 mr-2">$</span>
<input class="w-full bg-transparent border-t-0 border-x-0 border-b border-outline/30 focus:border-black focus:ring-0 px-0 py-3 text-lg font-medium placeholder:text-stone-300 transition-all" placeholder="Optional" type="text" name="discount"/>
</div>
</div>
</div>
</div>
<div class="pt-6">
<input class="bg-black text-white px-10 py-4 font-bold tracking-widest uppercase text-xs hover:bg-stone-800 transition-all active:scale-95" value="Publish to Archive" type="submit"/>
                            
                        
</div>
</form>
</div>
<!-- Panel Configuration Column -->
<div class="lg:col-span-5">
<div class="sticky top-32 bg-surface-container-low p-10 space-y-12">
<header class="space-y-2">
<span class="label-md tracking-[0.2em] text-secondary font-semibold uppercase">UI Configuration</span>
<h2 class="text-3xl font-extrabold tracking-tighter text-black">Panel Details</h2>
</header>
<div class="space-y-8">
<div class="relative">
<label class="block text-[10px] font-bold uppercase tracking-[0.15em] text-stone-400 mb-1">Background Color</label>
<div class="flex items-center space-x-3">
<div class="w-6 h-6 rounded-full bg-[#faf9f7] border border-outline-variant/30"></div>
<input class="w-full bg-transparent border-t-0 border-x-0 border-b border-outline/30 focus:border-black focus:ring-0 px-0 py-2 text-sm font-medium transition-all" type="text" value="#FAF9F7"/>
</div>
</div>
<div class="relative">
<label class="block text-[10px] font-bold uppercase tracking-[0.15em] text-stone-400 mb-1">Panel Color</label>
<div class="flex items-center space-x-3">
<div class="w-6 h-6 rounded-full bg-[#f4f3f1] border border-outline-variant/30"></div>
<input class="w-full bg-transparent border-t-0 border-x-0 border-b border-outline/30 focus:border-black focus:ring-0 px-0 py-2 text-sm font-medium transition-all" type="text" value="#F4F3F1"/>
</div>
</div>
<div class="relative">
<label class="block text-[10px] font-bold uppercase tracking-[0.15em] text-stone-400 mb-1">Color</label>
<div class="flex items-center space-x-3">
<div class="w-6 h-6 rounded-full bg-[#000000]"></div>
<input class="w-full bg-transparent border-t-0 border-x-0 border-b border-outline/30 focus:border-black focus:ring-0 px-0 py-2 text-sm font-medium transition-all" type="text" value="#000000"/>
</div>
</div>
</div>
<div class="p-6 bg-surface-container-highest/30 space-y-4">
<p class="text-[10px] font-bold uppercase tracking-[0.15em] text-stone-500">Live Preview Tone</p>
<div class="h-24 w-full bg-[#faf9f7] border border-outline-variant/10 relative overflow-hidden">
<div class="absolute inset-y-4 inset-x-8 bg-[#f4f3f1] shadow-sm flex items-center justify-center">
<span class="text-[8px] uppercase tracking-widest font-bold text-black">Atelier Canvas</span>
</div>
</div>
</div>
</div>
</div>
</div>
</main>
<!-- Footer -->
<footer class="w-full mt-24 bg-stone-100 dark:bg-stone-900">
<div class="grid grid-cols-1 md:grid-cols-3 gap-12 px-12 py-20 w-full md:ml-64 max-w-[calc(100%-16rem)]">
<div class="space-y-6">
<div class="text-lg font-bold text-black dark:text-white">ARCHIVE ADMIN</div>
<p class="text-stone-500 font-manrope text-sm tracking-widest uppercase leading-relaxed">
                    © 2024 ARCHIVE ADMIN INTERFACE. CONFIDENTIAL.
                </p>
</div>
<nav class="flex flex-col space-y-4">
<p class="text-[10px] font-black tracking-[0.2em] uppercase text-stone-400 mb-2">Resources</p>
<a class="font-manrope text-sm tracking-widest uppercase text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Support</a>
<a class="font-manrope text-sm tracking-widest uppercase text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Security</a>
<a class="font-manrope text-sm tracking-widest uppercase text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Privacy Policy</a>
</nav>
<div class="space-y-4">
<p class="text-[10px] font-black tracking-[0.2em] uppercase text-stone-400 mb-2">Status</p>
<div class="flex items-center space-x-2">
<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
<span class="font-manrope text-sm tracking-widest uppercase text-black dark:text-white">Systems Operational</span>
</div>
</div>
</div>
</footer>
</body></html>