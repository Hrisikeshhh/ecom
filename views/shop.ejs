<body class="bg-surface text-on-surface selection:bg-secondary-fixed">
<!-- TopNavBar -->
<nav class="fixed top-0 w-full z-50 bg-stone-50/80 dark:bg-stone-950/80 backdrop-blur-xl">
<div class="flex justify-between items-center px-8 py-6 w-full max-w-screen-2xl mx-auto">
<div class="text-2xl font-black tracking-tighter text-black dark:text-white uppercase">ARCHIVE</div>
<div class="hidden md:flex items-center space-x-10 font-manrope tracking-tight font-medium">
<a class="text-stone-500 dark:text-stone-400 font-medium hover:text-black dark:hover:text-white transition-colors duration-300" href="#">Home</a>
<a class="text-black dark:text-white font-bold border-b-2 border-stone-800 dark:border-stone-200 pb-1 hover:text-black dark:hover:text-white transition-colors duration-300" href="#">Products</a>
<a class="text-stone-500 dark:text-stone-400 font-medium hover:text-black dark:hover:text-white transition-colors duration-300" href="#">My Account</a>
<a class="text-stone-500 dark:text-stone-400 font-medium hover:text-black dark:hover:text-white transition-colors duration-300" href="#">Cart</a>
</div>
<div class="flex items-center space-x-6">
<button class="scale-95 active:opacity-70 transition-all text-black dark:text-white">
<span class="material-symbols-outlined" data-icon="search">search</span>
</button>
<button class="scale-95 active:opacity-70 transition-all text-black dark:text-white relative">
<span class="material-symbols-outlined" data-icon="shopping_bag">shopping_bag</span>
<span class="absolute -top-1 -right-1 w-2 h-2 bg-secondary rounded-full"></span>
</button>
</div>
</div>
</nav>
<main class="pt-32 pb-24 px-8 max-w-screen-2xl mx-auto min-h-screen">
<div class="flex flex-col md:flex-row gap-16">
<!-- Sidebar Navigation/Filter -->
<aside class="w-full md:w-64 flex-shrink-0">
<div class="sticky top-40">
<h3 class="font-headline text-xs font-bold tracking-[0.2em] uppercase text-on-surface-variant mb-8">Collections</h3>
<ul class="space-y-6">
<li>
<a class="group flex items-center justify-between text-on-surface-variant hover:text-primary transition-colors" href="#">
<span class="font-headline text-lg tracking-tight">Popular</span>
<span class="material-symbols-outlined text-sm opacity-0 group-hover:opacity-100 transition-opacity" data-icon="arrow_forward">arrow_forward</span>
</a>
</li>
<li>
<a class="group flex items-center justify-between text-on-surface-variant hover:text-primary transition-colors" href="#">
<span class="font-headline text-lg tracking-tight">New</span>
<span class="material-symbols-outlined text-sm opacity-0 group-hover:opacity-100 transition-opacity" data-icon="arrow_forward">arrow_forward</span>
</a>
</li>
<li>
<a class="group flex items-center justify-between text-primary transition-colors" href="#">
<span class="font-headline text-lg font-bold tracking-tight">All Products</span>
<span class="material-symbols-outlined text-sm opacity-100" data-icon="arrow_forward">arrow_forward</span>
</a>
</li>
<li>
<a class="group flex items-center justify-between text-on-surface-variant hover:text-primary transition-colors" href="#">
<span class="font-headline text-lg tracking-tight">Discounted Products</span>
<span class="material-symbols-outlined text-sm opacity-0 group-hover:opacity-100 transition-opacity" data-icon="arrow_forward">arrow_forward</span>
</a>
</li>
</ul>
<div class="mt-20 pt-10 border-t border-outline-variant/10">
<h3 class="font-headline text-xs font-bold tracking-[0.2em] uppercase text-on-surface-variant mb-6">Material</h3>
<div class="flex flex-wrap gap-2">
<span class="px-4 py-2 bg-surface-container-high rounded-full text-xs font-bold tracking-widest uppercase cursor-pointer hover:bg-primary hover:text-on-primary transition-all">Leather</span>
<span class="px-4 py-2 bg-surface-container-high rounded-full text-xs font-bold tracking-widest uppercase cursor-pointer hover:bg-primary hover:text-on-primary transition-all">Suede</span>
<span class="px-4 py-2 bg-surface-container-high rounded-full text-xs font-bold tracking-widest uppercase cursor-pointer hover:bg-primary hover:text-on-primary transition-all">Canvas</span>
</div>
</div>
</div>
</aside>
<!-- Main Content: Product Grid -->
<div class="flex-grow">
<header class="mb-16">
<h1 class="text-5xl md:text-7xl font-headline font-black tracking-tighter mb-4">THE ARCHIVE</h1>
<p class="text-on-surface-variant max-w-xl font-body leading-relaxed">
                        Curated artifacts of utility and elegance. Each piece is designed to withstand the passage of time, crafted from the finest materials with architectural precision.
                    </p>
</header>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-20 gap-x-12">
<!-- Card 1 -->



<% products.forEach((product)=>{ %>
        <div class="group cursor-pointer">
<div class="aspect-[4/5] bg-surface-container-low mb-6 overflow-hidden relative">
<img alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" data-alt="Close-up of a high-end minimalist black leather briefcase resting on a white stone surface with soft architectural shadows" src="data:image/png;base64,<%= product.image.toString('base64')%>"/>
<div class="absolute top-4 right-4">
<span class="bg-secondary-fixed text-on-secondary-fixed text-[10px] font-bold tracking-widest uppercase px-3 py-1 rounded-full">Limited</span>
</div>
</div>
<div class="flex justify-between items-start">
<div>
<h3 class="font-headline text-xl font-bold tracking-tight mb-1 group-hover:text-secondary transition-colors"><%= product.name %></h3>
<p class="text-sm font-label tracking-widest uppercase text-on-surface-variant">discount <%= product.discount %>%</p>
</div>
<span class="font-headline text-lg font-medium">$<%= product.price %></span>
</div>
        </div>

<% }) %>












