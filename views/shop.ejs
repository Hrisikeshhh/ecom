</main>
<!-- Footer -->
<footer class="bg-stone-100 dark:bg-stone-900 w-full mt-24">
<div class="grid grid-cols-1 md:grid-cols-3 gap-12 px-12 py-20 w-full max-w-screen-2xl mx-auto">
<div class="space-y-6">
<div class="text-lg font-bold text-black dark:text-white tracking-widest">ARCHIVE</div>
<p class="text-stone-500 dark:text-stone-400 font-manrope text-sm leading-relaxed max-w-xs">
                    Redefining luxury through architectural permanence and uncompromising craft.
                </p>
</div>
<div class="grid grid-cols-2 gap-8">
<div class="space-y-4">
<h4 class="font-manrope text-xs font-black tracking-widest uppercase text-black dark:text-white">Shop</h4>
<ul class="space-y-2 font-manrope text-sm tracking-widest uppercase text-stone-500 dark:text-stone-400">
<li><a class="hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Collections</a></li>
<li><a class="hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">New In</a></li>
<li><a class="hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Bespoke</a></li>
</ul>
</div>
