<div class="col-span-1 lg:col-span-5 flex flex-col justify-center bg-surface lg:pl-20 py-12 lg:py-0">
<div class="max-w-md w-full">
<header class="mb-12">
<h1 class="text-4xl font-headline font-bold tracking-tight text-primary mb-2">Welcome Back.</h1>
<p class="text-on-surface-variant font-medium">Please enter your details to access your archive.</p>
</header>
<!-- Form -->
<form action="/users/login" class="space-y-10" method="POST">
<div class="space-y-8">
<div class="relative group">
<label class="label-sm tracking-widest text-on-surface uppercase opacity-50 block mb-2" for="email" >Email Address</label>
<input class="w-full bg-transparent border-t-0 border-x-0 border-b border-outline/30 px-0 py-3 text-on-surface placeholder:text-outline-variant/50 transition-all form-input-focus" id="email" name="email" placeholder="email@example.com" required="" type="email" />
</div>
<div class="relative group">
<div class="flex justify-between items-center mb-2">
<label class="label-sm tracking-widest text-on-surface uppercase opacity-50 block" for="password" >Password</label>
<a class="text-[10px] uppercase tracking-widest font-bold text-secondary hover:opacity-70 transition-opacity" href="#">Forgot Password?</a>
</div>
<input class="w-full bg-transparent border-t-0 border-x-0 border-b border-outline/30 px-0 py-3 text-on-surface placeholder:text-outline-variant/50 transition-all form-input-focus" id="password" name="password" placeholder="••••••••" required="" type="password"/>
<!-- Error State Placeholder (Hidden) -->
<p class="hidden mt-2 text-xs text-error font-medium">Invalid credentials. Please try again.</p>
</div>
</div>
<div class="space-y-6">
<input class="w-full bg-primary text-on-primary py-5 font-bold tracking-widest uppercase text-sm hover:opacity-90 active:scale-[0.98] transition-all" type="submit" value="sign in" />
                              
                            
<div class="relative flex items-center justify-center">
<div class="flex-grow border-t border-outline/10"></div>
<span class="mx-4 text-[10px] uppercase tracking-widest text-outline-variant">Or continue with</span>
<div class="flex-grow border-t border-outline/10"></div>
</div>
<div class="grid grid-cols-2 gap-4">
<button class="flex items-center justify-center gap-3 py-4 bg-surface-container-high hover:bg-surface-container-highest transition-colors active:scale-[0.98]" type="button">
<svg class="w-5 h-5" viewbox="0 0 24 24">
<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="currentColor"></path>
<path d="M12 23c2.97 0 5.46-.98 7.28-2.65l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="currentColor"></path>
<path d="M5.84 14.11c-.22-.66-.35-1.36-.35-2.11s.13-1.45.35-2.11V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.83z" fill="currentColor"></path>
<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.83c.87-2.6 3.3-4.53 12-4.53z" fill="currentColor"></path>
</svg>
<span class="label-sm font-bold tracking-widest uppercase">Google</span>
</button>
<button class="flex items-center justify-center gap-3 py-4 bg-surface-container-high hover:bg-surface-container-highest transition-colors active:scale-[0.98]" type="button">
