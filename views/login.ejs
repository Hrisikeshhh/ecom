<div class="flex flex-col gap-4">
<a class="font-manrope text-sm tracking-widest uppercase text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Contact</a>
<a class="font-manrope text-sm tracking-widest uppercase text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Terms</a>
