<path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C4.7 17.5 4.3 12.5 6.7 11.2c1.2-.6 2.3-.3 3 .1 1.2.6 1.8.6 3 0 .6-.3 1.9-.8 3.3-.1 1.3.6 2.1 1.8 2.5 3-2.7 1.3-2.3 5.3.4 6.4-.6 1.3-1.1 2.3-1.85 2.68zM12.03 7.25c-.2 2.2-2 4.1-4.1 4-2.3-.1-4.2-2.2-4-4.5.2-2.2 2-4.1 4.1-4 2.2.1 4.2 2.2 4 4.5z" fill="currentColor"></path>
</svg>
<span class="label-sm font-bold tracking-widest uppercase">Apple</span>
</button>
