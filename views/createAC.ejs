<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "secondary-container": "#fdcb9b",
                        "error-container": "#ffdad6",
                        "background": "#faf9f7",
                        "surface-container-low": "#f4f3f1",
                        "secondary-fixed": "#ffdcbd",
                        "primary-fixed": "#e5e2e1",
                        "on-surface": "#1a1c1b",
                        "on-surface-variant": "#444748",
                        "primary": "#000000",
                        "on-primary": "#ffffff",
                        "surface-container": "#efeeec",
                        "outline": "#747878",
                        "surface-container-highest": "#e3e2e0",
                        "on-background": "#1a1c1b",
                        "surface-container-high": "#e9e8e6",
                        "outline-variant": "#c4c7c7",
                        "on-secondary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "tertiary": "#000000",
                        "secondary": "#7c5730",
                        "surface": "#faf9f7",
                    },
                    fontFamily: {
                        "headline": ["Manrope"],
                        "body": ["Manrope"],
                        "label": ["Manrope"]
                    },
                    borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            font-family: 'Manrope', sans-serif;
            background-color: #faf9f7;
        }
        .minimal-input {
            border: none;
            border-bottom: 1px solid rgba(116, 120, 120, 0.3);
            border-radius: 0;
            padding-left: 0;
            padding-right: 0;
            background-color: transparent;
        }
        .minimal-input:focus {
            outline: none;
            box-shadow: none;
            border-bottom: 1px solid #000000;
            background-color: #ffffff;
        }
    </style>
</head>
<body class="text-on-background">
<!-- TopNavBar: Execution of JSON Brand Anchor -->
<!-- Suppression logic: Navigation shell is suppressed for transactional "Create Account" screen to prioritize the focus canvas -->
 <% if(error.length>0){ %>
    <span>
        <%= error %>
    </span>
 <% } %>
<header class="fixed top-0 w-full z-50 bg-stone-50/80 backdrop-blur-xl">
<div class="flex justify-between items-center px-8 py-6 w-full max-w-screen-2xl mx-auto">
<div class="text-2xl font-black tracking-tighter text-black">ARCHIVE</div>
<nav class="hidden md:flex gap-12 text-stone-500 font-medium">
</nav>
<div class="flex items-center gap-6">

</div>
</div>
</header>
<main class="min-h-screen flex flex-col md:flex-row pt-20">
<!-- Left Side: Editorial Canvas -->
<section class="relative w-full md:w-1/2 h-[512px] md:h-auto overflow-hidden bg-surface-container-low">
<img alt="Luxury leather bag archive" class="absolute inset-0 w-full h-full object-cover grayscale brightness-90" data-alt="Close-up of a high-end luxury black leather tote bag with architectural stitching, soft studio lighting on a neutral beige background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC1rIt7pxOuwzayE3zWEjru614gAIsJQodLNwa_n_i_USeay2-yGcg_AahZcX0-vqOCh7ami-zUS_7h_2sueZ_DCRDsHrvZq6WCvbidyP1tko1EKcu5_vNA7byicQ2mpTw_JiJX77AQKC5NA3S1mLjghGCBjCi_v6Xba3iUpHXvY4zIFzOjYRktlUMqFYNzznVom3eqIN2h_k3rXZ5KXHDQzFVDhgh1bsKF_4bpjSPyyoQ5rizCjnUNgGxXKwp15okw6otc9t0zDRk"/>
<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
<div class="absolute bottom-16 left-12 right-12">
<h2 class="text-white text-3xl md:text-5xl font-black tracking-tighter leading-none mb-4">JOIN THE ARCHIVE.</h2>
<p class="text-white/80 font-label tracking-widest text-sm uppercase">QUALITY CRAFTED FOR LIFE.</p>
</div>
</section>
<!-- Right Side: Signup Form -->
<section class="w-full md:w-1/2 flex items-center justify-center p-8 md:p-24 bg-surface">
<div class="w-full max-w-md">
<div class="mb-12">
<h1 class="text-4xl font-black tracking-tighter text-primary mb-3">Start Your Archive.</h1>
<p class="text-on-surface-variant text-lg">Create an account to save your favorite pieces and track orders.</p>
</div>
<form class="space-y-8" method="post" action="/users/register">
<div class="grid grid-cols-2 gap-6">
<div class="flex flex-col gap-2">
<label class="text-[10px] font-bold tracking-widest uppercase text-outline">Full name</label>
<input class="minimal-input" placeholder="Enter first name" type="text" name="fullName"/>
</div>
<div class="flex flex-col gap-2">
</div>
</div>
<div class="flex flex-col gap-2">
<label class="text-[10px] font-bold tracking-widest uppercase text-outline" >EMAIL ADDRESS</label>
<input class="minimal-input" placeholder="name@domain.com" name="email" type="email"/>
</div>
<div class="flex flex-col gap-2">
<label class="text-[10px] font-bold tracking-widest uppercase text-outline">PASSWORD</label>
<input class="minimal-input" placeholder="••••••••" type="password" name="password"/>
</div>
<input class="w-full py-5 bg-primary text-on-primary font-bold tracking-widest uppercase text-sm hover:opacity-90 transition-all active:scale-[0.98]" type="submit" value="CREATE ACCOUNT" />
                       

</form>
<div class="mt-10 space-y-4">
<div class="relative flex items-center py-2">
<div class="flex-grow border-t border-outline/20"></div>
<span class="flex-shrink mx-4 text-[10px] font-bold text-outline tracking-widest uppercase">OR CONTINUE WITH</span>
<div class="flex-grow border-t border-outline/20"></div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<button class="flex items-center justify-center gap-3 py-4 bg-surface-container-high text-primary font-bold text-xs tracking-widest uppercase hover:bg-surface-container-highest transition-colors">
<svg class="w-4 h-4" viewbox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="currentColor"></path><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="currentColor"></path><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="currentColor"></path><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="currentColor"></path></svg>
                            SIGN UP WITH GOOGLE
                        </button>
<button class="flex items-center justify-center gap-3 py-4 bg-surface-container-high text-primary font-bold text-xs tracking-widest uppercase hover:bg-surface-container-highest transition-colors">
<svg class="w-4 h-4" viewbox="0 0 24 24"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.11.8 1.12-.1 2.36-.91 3.72-.73 1.61.08 2.84.69 3.6 1.83-3.18 1.93-2.68 6.06.5 7.33-.65 1.64-1.52 3.25-2.93 4.74M12.03 7.25c-.14-2.73 2.1-5.11 4.67-5.25.32 2.76-2.5 5.31-4.67 5.25z" fill="currentColor"></path></svg>
                            SIGN UP WITH APPLE
                        </button>
</div>
</div>
<div class="mt-12 text-center">
<p class="text-stone-500 font-medium">
                        Already have an account? 
                        <a class="text-black font-bold underline underline-offset-4 hover:opacity-70 transition-opacity" href="/login">Sign in</a>
</p>
</div>
</div>
</section>
</main>
<!-- Footer: Execution of JSON Brand Anchor -->
<footer class="w-full mt-24 bg-stone-100 dark:bg-stone-900 tonal-shift-no-borders">
<div class="grid grid-cols-1 md:grid-cols-3 gap-12 px-12 py-20 w-full max-w-screen-2xl mx-auto">
<div class="space-y-4">
<div class="text-lg font-bold text-black dark:text-white">ARCHIVE</div>
<p class="text-stone-500 dark:text-stone-400 font-manrope text-sm tracking-widest uppercase">© 2024 ARCHIVE. ALL RIGHTS RESERVED.</p>
</div>
<div class="grid grid-cols-2 gap-8">
<div class="space-y-3">
<h4 class="text-xs font-black tracking-[0.2em] text-black dark:text-white uppercase">Menu</h4>
<ul class="space-y-2">
<li><a class="text-stone-500 dark:text-stone-400 text-sm hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Customer Service</a></li>
<li><a class="text-stone-500 dark:text-stone-400 text-sm hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Shipping Info</a></li>
</ul>
</div>
<div class="space-y-3">
<h4 class="text-xs font-black tracking-[0.2em] text-black dark:text-white uppercase">Legal</h4>
<ul class="space-y-2">
<li><a class="text-stone-500 dark:text-stone-400 text-sm hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Contact</a></li>
<li><a class="text-stone-500 dark:text-stone-400 text-sm hover:text-stone-800 dark:hover:text-stone-200 underline-offset-4 hover:underline transition-opacity" href="#">Terms</a></li>
</ul>
</div>
</div>
<div class="space-y-4">
<h4 class="text-xs font-black tracking-[0.2em] text-black dark:text-white uppercase">Newsletter</h4>
<div class="relative">
<input class="w-full bg-transparent border-b border-stone-300 dark:border-stone-700 py-2 focus:outline-none focus:border-black dark:focus:border-white text-xs font-bold tracking-widest transition-colors" placeholder="YOUR EMAIL" type="email"/>
</div>
</div>
</div>
</footer>
</body></html>